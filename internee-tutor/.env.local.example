# ---- Groq (FREE AI API — OpenAI-compatible, used instead of paid OpenAI) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override if Groq deprecates the default model (see lib/groq.js)
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Firebase (free Spark plan is enough) ----
# Get these from Firebase Console > Project Settings > General > Your apps > SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
